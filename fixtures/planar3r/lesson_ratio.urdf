<?xml version="1.0"?>
<!-- Project-authored planar 3R fixture: Project-authored copy of lesson link ratios -->
<robot name="project_planar3r_lesson_ratio">
  <link name="base_link"/>
  <link name="link_1">
    <visual>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.04 0.04"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.04 0.04"/></geometry>
    </collision>
  </link>
  <link name="link_2">
    <visual>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.04 0.04"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.04 0.04"/></geometry>
    </collision>
  </link>
  <link name="link_3">
    <visual>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <geometry><box size="0.18 0.04 0.04"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <geometry><box size="0.18 0.04 0.04"/></geometry>
    </collision>
  </link>
  <link name="tool0"/>

  <joint name="joint_1" type="continuous">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="joint_2" type="continuous">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="joint_3" type="continuous">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="tool_fixed" type="fixed">
    <parent link="link_3"/><child link="tool0"/>
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
  </joint>
</robot>
