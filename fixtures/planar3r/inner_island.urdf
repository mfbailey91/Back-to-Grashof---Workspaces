<?xml version="1.0"?>
<!-- Project-authored planar 3R fixture: Unequal proximal links / inner island -->
<robot name="project_planar3r_inner_island">
  <link name="base_link"/>
  <link name="link_1">
    <visual>
      <origin xyz="1.5 0 0" rpy="0 0 0"/>
      <geometry><box size="3 0.18 0.18"/></geometry>
    </visual>
    <collision>
      <origin xyz="1.5 0 0" rpy="0 0 0"/>
      <geometry><box size="3 0.18 0.18"/></geometry>
    </collision>
  </link>
  <link name="link_2">
    <visual>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <geometry><box size="1 0.18 0.18"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <geometry><box size="1 0.18 0.18"/></geometry>
    </collision>
  </link>
  <link name="link_3">
    <visual>
      <origin xyz="1.25 0 0" rpy="0 0 0"/>
      <geometry><box size="2.5 0.18 0.18"/></geometry>
    </visual>
    <collision>
      <origin xyz="1.25 0 0" rpy="0 0 0"/>
      <geometry><box size="2.5 0.18 0.18"/></geometry>
    </collision>
  </link>
  <link name="tool0"/>

  <joint name="joint_1" type="continuous">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="joint_2" type="continuous">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="3 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="joint_3" type="continuous">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="1 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="tool_fixed" type="fixed">
    <parent link="link_3"/><child link="tool0"/>
    <origin xyz="2.5 0 0" rpy="0 0 0"/>
  </joint>
</robot>
