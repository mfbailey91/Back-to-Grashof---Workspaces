{
  "schema_version": 2,
  "corpus_name": "Back to Grashof robot corpus",
  "selection_date": "2026-08-03",
  "groups": {
    "primary_6r": {
      "description": "Nonredundant six-revolute-joint spatial manipulators.",
      "expected_count": 13
    },
    "redundant_7r_control": {
      "description": "Seven-revolute-joint controls that should reject naive 6R reductions.",
      "expected_count": 4
    },
    "planar_3r_external": {
      "description": "External three-revolute-joint planar ingestion control.",
      "expected_count": 1
    },
    "planar_3r_project": {
      "description": "Project-authored analytical ground-truth instances.",
      "expected_count": 6
    }
  },
  "raw_source_policy": "Clone upstream repositories into gitignored third_party/robot_corpus and retain exact Git commits in provenance records.",
  "sources": [
    {
      "id": "universal_robots_ros2_description",
      "repository": "https://github.com/UniversalRobots/Universal_Robots_ROS2_Description.git",
      "branch": "rolling",
      "license_spdx": "BSD-3-Clause AND LicenseRef-UR-Graphical-Documentation",
      "license_status": "mixed",
      "notes": [
        "UR8 Long, UR15, UR20, and UR30 mesh assets have additional Universal Robots graphical-documentation terms.",
        "Kinematic configuration files and other repository content are BSD-3-Clause according to upstream."
      ]
    },
    {
      "id": "kuka_robot_descriptions",
      "repository": "https://github.com/kroshu/kuka_robot_descriptions.git",
      "branch": "master",
      "license_spdx": "Apache-2.0",
      "license_status": "verified",
      "notes": [
        "ROS 2 KUKA support repository with AGILUS, CYBERTECH, QUANTEC, and LBR iiwa models."
      ]
    },
    {
      "id": "ros_industrial_fanuc",
      "repository": "https://github.com/ros-industrial/fanuc.git",
      "branch": "noetic-devel",
      "license_spdx": "BSD-3-Clause",
      "license_status": "verify_package_snapshot",
      "notes": [
        "Community-supported ROS-Industrial source; not OEM-supported."
      ]
    },
    {
      "id": "kinova_ros",
      "repository": "https://github.com/Kinovarobotics/kinova-ros.git",
      "branch": "noetic-devel",
      "license_spdx": "BSD-3-Clause",
      "license_status": "verify_package_snapshot",
      "notes": [
        "Use Jaco2 J2N6S300 arm chain only; finger joints are excluded."
      ]
    },
    {
      "id": "xarm_ros2",
      "repository": "https://github.com/xArm-Developer/xarm_ros2.git",
      "branch": null,
      "license_spdx": "BSD-3-Clause",
      "license_status": "verified",
      "notes": [
        "Official UFACTORY ROS 2 repository."
      ]
    },
    {
      "id": "franka_description",
      "repository": "https://github.com/frankarobotics/franka_description.git",
      "branch": "main",
      "license_spdx": "Apache-2.0",
      "license_status": "verified",
      "notes": [
        "Generate arm-only URDFs without an end effector for FR3 v2.1 and FER."
      ]
    },
    {
      "id": "fetch_ros",
      "repository": "https://github.com/fetchrobotics/fetch_ros.git",
      "branch": "ros1",
      "license_spdx": "CC-BY-NC-SA-4.0",
      "license_status": "verified_noncommercial",
      "notes": [
        "The corpus selects only the seven-revolute-joint arm from torso_lift_link to wrist_roll_link.",
        "The mobile base, torso lift, head, sensors, and gripper are outside the selected manipulator chain."
      ]
    },
    {
      "id": "lesson_urdf",
      "repository": "https://github.com/olmerg/lesson_urdf.git",
      "branch": "master",
      "license_spdx": "MIT",
      "license_status": "verified",
      "notes": [
        "External planar 3R ingestion control with stated lengths 0.5, 0.5, and 0.18."
      ]
    }
  ],
